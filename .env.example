APP_NAME="ChargeOps AI"
APP_ENVIRONMENT="development"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"
WEATHER_BASE_URL="https://api.open-meteo.com/v1/forecast"
CHARGEOPS_API_URL="http://127.0.0.1:8000"

POSTGRES_DB="chargeops"
POSTGRES_USER="chargeops"
POSTGRES_PASSWORD="change-me"

EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSIONS=1536

DATABASE_URL="postgresql+psycopg://chargeops:change-me@localhost:5432/chargeops"

KNOWLEDGE_MIN_SIMILARITY=0.45
KNOWLEDGE_MAX_CHUNKS_PER_DOCUMENT=2
KNOWLEDGE_CANDIDATE_MULTIPLIER=6

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=chargeops-ai

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ISSUER=chargeops-ai
JWT_AUDIENCE=chargeops-api
JWT_LEEWAY_SECONDS=30
ACCESS_TOKEN_EXPIRE_MINUTES=30

LOGIN_RATE_LIMIT_IP_ATTEMPTS=20
LOGIN_RATE_LIMIT_ACCOUNT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

CORS_ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

SECURITY_ENABLE_HSTS=false
SECURITY_HSTS_MAX_AGE=31536000

# OpenAI reliability
OPENAI_TIMEOUT_SECONDS=45
OPENAI_CONNECT_TIMEOUT_SECONDS=5
OPENAI_MAX_RETRIES=2

# Weather reliability
WEATHER_CONNECT_TIMEOUT_SECONDS=3
WEATHER_READ_TIMEOUT_SECONDS=5
WEATHER_WRITE_TIMEOUT_SECONDS=5
WEATHER_POOL_TIMEOUT_SECONDS=2
WEATHER_MAX_CONNECTIONS=20
WEATHER_MAX_KEEPALIVE_CONNECTIONS=10
WEATHER_MAX_ATTEMPTS=3
WEATHER_RETRY_BASE_DELAY_SECONDS=0.25

# Database reliability
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_READY_TIMEOUT_SECONDS=3

# Observability reliability
OBSERVABILITY_WRITE_TIMEOUT_SECONDS=2

# Model Context Protocol
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_STREAMABLE_HTTP_PATH=/mcp

# External MCP client
EXTERNAL_MCP_TIMEOUT_SECONDS=45
EXTERNAL_MCP_MAX_CONTENT_CHARS=8000
EXTERNAL_MCP_ALLOWED_HOSTS=openchargealliance.org

# EV demand forecasting
FORECAST_MODEL_ARTIFACT_PATH=artifacts/demand_forecast.joblib
FORECAST_HISTORY_PATH=data/forecasting/demand_history.csv
FORECAST_HISTORY_LABEL=demo_simulation
FORECAST_DEFAULT_HORIZON_HOURS=24
FORECAST_MAX_HORIZON_HOURS=48
FORECAST_MAX_HISTORY_AGE_HOURS=48
FORECAST_WEATHER_TIMEOUT_SECONDS=10

# Optional ACN-Data research adapter
ACN_DATA_TOKEN=